{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "plugin-agent-chat",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/agents/*", "/api/*"]
  },
  "ai": { "binding": "AI", "remote": true },
  "vars": {
    "MODEL_ID": "@cf/zai-org/glm-4.7-flash",
    "AUTH_MODE": "access",
    "ACCESS_TEAM_DOMAIN": "myksyut.cloudflareaccess.com",
    "ACCESS_AUD": "5d451ac789073184cf05f255a9d047ddc98a3e78f0cfb7d645b81df384308c14"
  },
  "durable_objects": {
    "bindings": [{ "name": "UserAgent", "class_name": "UserAgent" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UserAgent"] }],
  "observability": { "enabled": true }
}
